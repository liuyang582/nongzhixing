<view class="page"><view class="hero"><view class="brand">农知行</view><view class="title">{{user.name}}</view><view class="muted">{{user.org}} · {{user.district}}</view></view><view wx:if="{{error}}" class="error">{{error}}</view><view class="card"><view class="kv"><text class="key">账号</text><text class="value">{{user.username}}</text></view><view class="kv"><text class="key">角色</text><text class="value">{{user.role==='farmer'?'种植户':user.role==='regulator'?'农业监管员':'系统管理员'}}</text></view><button bindtap="go" data-url="/pages/editor/index?kind=password">修改密码</button><button bindtap="go" data-url="/pages/service/index?kind=files">附件管理</button><button bindtap="go" data-url="/pages/service/index?kind=reports">报表下载</button><button wx:if="{{user.role==='admin'}}" bindtap="go" data-url="/pages/service/index?kind=users">账号管理</button><button wx:if="{{user.role==='admin'}}" bindtap="go" data-url="/pages/service/index?kind=audit">操作审计</button><button bindtap="logout">退出登录</button></view><view class="note">AI 建议需人工确认。演示样本与用户记录分别标注。</view></view>
