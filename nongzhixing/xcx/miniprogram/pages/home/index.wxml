<view class="page"><view class="hero"><view class="brand">农知行 · 农业工作台</view><view class="title">{{user.name||'我的农场'}}</view><view class="muted">生产有记录，管理有依据。</view></view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><view wx:if="{{dash}}" class="grid"><view class="card"><view class="muted">业务记录</view><view class="big">{{dash.records}}</view><view class="muted">{{dash.demo_records}} 条演示样本</view></view><view class="card"><view class="muted">可用库存</view><view class="big">{{dash.available_stock}} kg</view></view><view class="card"><view class="muted">待出库订单</view><view class="big">{{dash.pending_orders}}</view></view><view class="card"><view class="muted">已出库销售</view><view class="big">¥{{dash.sales}}</view></view></view><view class="card"><view class="section-title">常用功能</view><view class="grid"><button bindtap="go" data-url="/pages/index/index">地块与地图</button><button bindtap="go" data-url="/pages/records/index?module=tasks">农事任务</button><button bindtap="tab" data-url="/pages/ai/index">AI 智能助手</button><button bindtap="go" data-url="/pages/service/index?kind=notifications">消息与待办</button></view></view><view class="card"><view class="section-title">近期记录</view><view wx:for="{{dash.recent}}" wx:key="id" class="kv"><text class="key">{{item.title}}</text><text class="value">{{item.status}} · {{item.demo?'演示':'用户录入'}}</text></view><view wx:if="{{!dash.recent.length}}" class="muted">暂无记录</view></view></view>
