<view class="page"><view class="hero"><view class="brand">农业知识库</view><view class="title">带着问题，查依据。</view><view class="muted">全局共享农技档案 · 本地 BM25 检索 · 结果不构成用药处方</view></view><view wx:if="{{error}}" class="error">{{error}}</view><view class="card"><view class="label">问题或关键词</view><input value="{{q}}" data-key="q" bindinput="input" placeholder="例如：土壤板结怎么改良" maxlength="200" confirm-type="search" bindconfirm="search"/><view class="label">作物（可选）</view><input value="{{crop}}" data-key="crop" bindinput="input" placeholder="例如：番茄" maxlength="64"/><button class="primary" bindtap="search" loading="{{busy}}" disabled="{{busy}}">{{busy?'检索中…':'检索知识库'}}</button></view><view wx:if="{{hits.length}}" class="card"><view class="section-title">检索结果 · {{hits.length}} 条</view><view wx:for="{{hits}}" wx:key="id" class="hit" data-id="{{item.id}}" bindtap="open"><view class="row"><view class="name">{{item.doc_id}} · {{item.title}}</view><text class="badge">风险 {{item.risk_level}}</text></view><view class="tags"><text wx:for="{{item.crop}}" wx:for-item="crop" wx:key="*this" class="tag">{{crop}}</text><text class="tag">{{item.domain_l2}}</text></view><text class="snippet">{{item.snippet}}</text><view class="muted">来源：{{item.source||'未标注'}} →</view></view></view><view wx:if="{{selected}}" class="card"><view class="row"><view class="section-title">{{selected.doc_id}} · {{selected.title}}</view><button size="mini" bindtap="close">关闭</button></view><view class="muted">来源：{{selected.source||'未标注'}} · 时效 {{selected.stability}} · 风险 {{selected.risk_level}}</view><text class="answer" selectable>{{selected.content}}</text><button bindtap="copySource">复制来源</button><view class="note">以上为知识库原文，仅作参考依据；具体用药需核对产品登记证、标签和当地禁限用规定。</view></view><view wx:if="{{!hits.length && !busy}}" class="card empty">输入问题后检索农业知识档案</view></view>
