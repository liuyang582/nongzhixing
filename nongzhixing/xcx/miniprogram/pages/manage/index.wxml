<view class="page"><view class="hero"><view class="brand">生产与经营</view><view class="title">田间到销售</view><view class="muted">共用平台台账，按当前账号权限展示。</view></view><view wx:if="{{error}}" class="error">{{error}}</view><view class="card"><view class="section-title">种植管理</view><view class="grid"><button bindtap="go" data-url="/pages/index/index">地块边界与档案</button><button bindtap="go" data-url="/pages/service/index?kind=weather">天气中心</button><button wx:if="{{user.role==='farmer'}}" bindtap="go" data-url="/pages/service/index?kind=rules">环境阈值与预警</button><button bindtap="go" data-url="/pages/service/index?kind=guides">农技资料</button><button bindtap="go" data-url="/pages/knowledge/index">知识库与农技问答</button></view></view><view wx:if="{{user.role!=='admin'}}" class="card"><view class="section-title">经营管理</view><view class="grid"><button bindtap="go" data-url="/pages/service/index?kind=inventory">库存与销售</button><button wx:if="{{user.role==='farmer'}}" bindtap="go" data-url="/pages/service/index?kind=harvest">采收与溯源</button><button wx:if="{{user.role==='farmer'}}" bindtap="go" data-url="/pages/service/index?kind=finance">成本收益</button><button bindtap="go" data-url="/pages/service/index?kind=reports">台账报表</button></view></view><view class="card"><view class="section-title">业务台账</view><view class="menu-item" wx:for="{{modules}}" wx:key="id" bindtap="record" data-id="{{item.id}}"><text>{{item.title}}</text><text class="muted">{{item.group}} →</text></view></view></view>
