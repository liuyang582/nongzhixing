<view class="page"><view class="title">{{title}}</view><view wx:if="{{error}}" class="error">{{error}}</view><view class="card" wx:if="{{ready}}"><view wx:for="{{fields}}" wx:key="key" id="field-{{item.key}}"><view class="label">{{item.required?'* ':''}}{{item.label}}</view><picker wx:if="{{item.type==='date'}}" mode="date" value="{{values[item.key]}}" bindchange="date" data-key="{{item.key}}" disabled="{{busy}}"><view class="picker">{{values[item.key]||'选择日期'}} ↓</view></picker><picker wx:elif="{{item.choices.length}}" range="{{item.choices}}" range-key="label" value="{{item.selected}}" bindchange="pick" data-key="{{item.key}}" disabled="{{busy}}"><view class="picker">{{item.choiceLabel}} ↓</view></picker><view wx:elif="{{item.type==='land'||item.type==='growth'||item.type==='stock'}}" class="muted">暂无可选记录，请先建立关联档案。</view><textarea wx:elif="{{item.type==='textarea'}}" value="{{values[item.key]}}" data-key="{{item.key}}" bindinput="input" disabled="{{busy}}" placeholder="填写{{item.label}}" maxlength="4000" auto-height/><input wx:else="" value="{{values[item.key]}}" data-key="{{item.key}}" bindinput="input" password="{{item.type==='password'}}" focus="{{focus===item.key}}" disabled="{{busy}}" placeholder="填写{{item.label}}" maxlength="{{item.type==='password'?128:180}}"/><view wx:if="{{errors[item.key]}}" class="field-error">{{errors[item.key]}}</view></view><button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存</button></view></view>
