<view class="page"><view class="hero"><view class="title">{{title}}</view><view class="muted">{{user.org}}</view></view><view wx:if="{{error}}" class="error">{{error}}</view><view class="card"><button bindtap="load" loading="{{busy}}" disabled="{{busy}}">刷新</button><view wx:if="{{kind==='inventory' && user.role==='farmer'}}" class="actions"><button bindtap="edit" data-kind="stock">农产品入库</button><button bindtap="edit" data-kind="order">创建订单</button></view><button wx:if="{{kind==='harvest'}}" bindtap="edit" data-kind="harvest">登记关联采收</button><button wx:if="{{kind==='rules'}}" bindtap="edit" data-kind="rule">新增预警规则</button><button wx:if="{{kind==='users'}}" bindtap="edit" data-kind="user">新增账号</button><button wx:if="{{kind==='files'}}" bindtap="upload" disabled="{{busy}}">上传附件</button><block wx:if="{{kind==='finance'}}"><view class="label">核算年度</view><input type="number" value="{{year}}" bindinput="inputYear" placeholder="例如：2026"/><view class="row"><view class="label">包含演示样本</view><switch checked="{{includeDemo}}" bindchange="demo" color="#246b47"/></view></block><picker wx:if="{{kind==='weather' && lands.length}}" range="{{lands}}" range-key="title" value="{{landIndex}}" bindchange="land"><view class="picker">{{lands[landIndex].title}} ↓</view></picker><picker wx:if="{{kind==='reports'}}" range="{{modules}}" range-key="title" value="{{moduleIndex}}" bindchange="module"><view class="picker">{{modules[moduleIndex].title||'暂无台账'}} ↓</view></picker><view wx:if="{{kind==='reports'||kind==='finance'}}" class="actions"><button bindtap="saveFile" data-format="xlsx" disabled="{{busy}}">下载 Excel</button><button bindtap="saveFile" data-format="pdf" disabled="{{busy}}">下载 PDF</button></view><view wx:if="{{note}}" class="note">{{note}}</view></view><view wx:if="{{summary.length}}" class="card"><view class="kv" wx:for="{{summary}}" wx:key="label"><text class="key">{{item.label}}</text><text class="value">{{item.value}}</text></view></view><view class="card" wx:for="{{rows}}" wx:key="id"><view class="row"><view class="name">{{item.title}}</view><text wx:if="{{item.demo}}" class="badge demo">演示</text></view><view class="kv" wx:for="{{item.details}}" wx:for-item="field" wx:key="label"><text class="key">{{field.label}}</text><text class="value">{{field.value}}</text></view><button wx:if="{{kind==='files'}}" bindtap="saveFile" data-id="{{item.id}}" disabled="{{busy}}">下载 / 预览</button><button wx:if="{{kind==='harvest' && item.data.status!=='已入库'}}" bindtap="action" data-id="{{item.id}}" data-action="stock" disabled="{{busy}}">确认采收入库</button><button wx:if="{{kind==='rules'}}" bindtap="action" data-id="{{item.id}}" data-action="toggle" disabled="{{busy}}">{{item.status==='启用'?'停用规则':'启用规则'}}</button><button wx:if="{{kind==='users'}}" bindtap="action" data-id="{{item.id}}" data-action="toggle" disabled="{{busy}}">{{item.active?'停用账号':'启用账号'}}</button><button wx:if="{{kind==='guides'}}" bindtap="source" data-id="{{item.id}}">复制官方资料链接</button><button wx:if="{{kind==='notifications'}}" bindtap="notify" data-id="{{item.id}}">进入处理</button></view><view wx:if="{{extra.length}}" class="section-title">{{kind==='inventory'?'销售订单':kind==='harvest'?'产品溯源':'月度收支'}}</view><view class="card" wx:for="{{extra}}" wx:key="id"><view class="name">{{item.title}}</view><view class="kv" wx:for="{{item.details}}" wx:for-item="field" wx:key="label"><text class="key">{{field.label}}</text><text class="value">{{field.value}}</text></view><view wx:if="{{kind==='inventory' && item.data.status==='待出库' && user.role==='farmer'}}" class="actions"><button bindtap="action" data-id="{{item.id}}" data-action="ship" disabled="{{busy}}">确认出库</button><button bindtap="action" data-id="{{item.id}}" data-action="cancel" disabled="{{busy}}">取消订单</button></view><block wx:if="{{kind==='harvest'}}"><view class="note">公开状态：{{item.published?'已公开':'未公开'}}。二维码沿用现有 PC 地址，实体手机扫码需设置可访问地址。</view><view class="actions"><button bindtap="action" data-id="{{item.id}}" data-action="publish" disabled="{{busy}}">{{item.published?'关闭公开':'确认公开'}}</button><button bindtap="saveFile" data-id="{{item.id}}" data-qr="{{true}}" disabled="{{busy}}">查看溯源码</button></view></block></view><view wx:if="{{!rows.length && !extra.length && !summary.length && !busy && kind!=='reports'}}" class="card empty">暂无数据</view></view>