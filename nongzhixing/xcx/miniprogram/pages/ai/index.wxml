<view class="page"><view class="hero"><view class="brand">农业智能助手</view><view class="title">带着资料，询问 AI。</view><view class="muted">结果需人工核验，不自动施药或操作库存。</view></view><view wx:if="{{error}}" class="error">{{error}}</view><view class="card"><view class="label">分析类型</view><view class="grid analysis-types"><button wx:for="{{kinds}}" wx:key="*this" class="{{kindIndex===index?'primary':''}}" data-index="{{index}}" bindtap="kind" disabled="{{busy}}">{{item}}{{kindIndex===index?' ✓':''}}</button></view><view class="label">作物</view><input value="{{crop}}" data-key="crop" bindinput="input" disabled="{{busy}}" placeholder="例如：番茄" maxlength="64"/><block wx:if="{{kindIndex===4}}"><view class="label">关联地块</view><picker range="{{lands}}" range-key="title" bindchange="land" disabled="{{busy}}"><view class="picker">{{landIndex>=0?lands[landIndex].title:'选择地块'}} ↓</view></picker><view class="label">生长批次</view><picker range="{{growth}}" range-key="title" bindchange="growth" disabled="{{busy}}"><view class="picker">{{growthIndex>=0?growth[growthIndex].title:'选择生长批次'}} ↓</view></picker><button bindtap="photo" disabled="{{busy}}">拍照 / 选择照片</button><image wx:if="{{imagePath}}" src="{{imagePath}}" mode="widthFix" class="photo"/></block><view class="label">* 问题描述</view><textarea value="{{question}}" data-key="question" bindinput="input" disabled="{{busy}}" placeholder="说明品种、地区、生长阶段及异常现象" maxlength="4000" auto-height/><button class="primary" bindtap="analyze" loading="{{busy}}" disabled="{{busy}}">{{busy?'正在分析，请稍候':'提交分析'}}</button></view><view wx:if="{{selected}}" class="card"><view class="section-title">分析结果 · {{selected.status}}</view><view class="note" wx:for="{{selected.steps}}" wx:key="*this">✓ {{item}}</view><text class="answer" selectable>{{selected.result.answer||'暂无回答'}}</text><block wx:if="{{selected.result.citations && selected.result.citations.length}}"><view class="section-title" style="margin-top:24rpx">参考知识</view><view wx:for="{{selected.result.citations}}" wx:key="id" class="ref"><text class="ref-title">[{{index+1}}] {{item.title}}</text><text class="ref-meta">{{item.source}} · {{item.stability}} · 风险 {{item.risk_level}}</text><text class="ref-snippet">{{item.snippet}}</text></view></block><view wx:else class="note">知识库未检索到直接依据，结论需补充资料或农技复核。</view><button bindtap="knowledge">打开知识库</button><view wx:if="{{selected.status==='待确认' && user.role==='farmer'}}" class="actions"><button class="primary" bindtap="confirm" disabled="{{busy}}">人工确认</button><button bindtap="reject" disabled="{{busy}}">驳回</button></view><button wx:if="{{selected.task_id}}" bindtap="tasks">查看任务 #{{selected.task_id}}</button></view><view class="card"><view class="row"><view class="section-title">分析历史</view><button size="mini" bindtap="refresh" disabled="{{busy}}">刷新</button></view><view wx:for="{{jobs}}" wx:key="id" class="menu-item" data-id="{{item.id}}" bindtap="select"><text>{{item.question}}</text><text class="muted">{{item.status}} →</text></view><view wx:if="{{!jobs.length}}" class="muted">暂无分析记录</view></view></view>
