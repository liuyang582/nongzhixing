<view class="page"><view class="hero"><view class="title">{{spec.title}}</view><view class="muted">共 {{total}} 条 · 按权限隔离</view></view><view wx:if="{{error}}" class="error">{{error}}</view><view class="card"><input value="{{q}}" bindinput="input" bindconfirm="search" placeholder="搜索记录标题"/><picker range="{{states}}" value="{{stateIndex}}" bindchange="status"><view class="picker">{{states[stateIndex]}} ↓</view></picker><view class="actions"><button bindtap="search" disabled="{{busy}}">查询</button><button wx:if="{{canWrite}}" bindtap="edit" class="primary">新增记录</button></view><view wx:if="{{spec.note}}" class="note">{{spec.note}}</view></view><view wx:for="{{rows}}" wx:key="id" class="card"><view class="row"><view class="name">{{item.title}}</view><text class="badge {{item.demo?'demo':''}}">{{item.demo?'演示':'用户录入'}}</text></view><view class="muted">{{item.status}}</view><view wx:for="{{item.details}}" wx:for-item="field" wx:key="label" class="kv"><text class="key">{{field.label}}</text><text class="value">{{field.value}}</text></view><button wx:if="{{spec.id==='lands'}}" bindtap="map" data-id="{{item.id}}">查看地图档案</button><view wx:if="{{canWrite}}" class="actions"><button bindtap="edit" data-id="{{item.id}}">编辑 / 任务反馈</button><button bindtap="remove" disabled="{{busy}}" data-id="{{item.id}}" class="danger">删除</button></view></view><view wx:if="{{!rows.length && !busy}}" class="card empty">暂无记录</view><button wx:if="{{total > rows.length}}" bindtap="more" loading="{{busy}}">加载更多</button></view>
